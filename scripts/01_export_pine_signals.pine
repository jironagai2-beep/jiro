//@version=5
indicator("Signal Export Template", overlay=true)

// ========================================
// このファイルは参照用テンプレートです
// 実際のPine Scriptロジックをここに配置してください
// ========================================

// エクスポート例：
// 1. TradingViewでこのスクリプトを実行
// 2. 以下のようなログ出力を追加
// 3. コンソールからCSVにコピー

// --- サンプル：MA計算 ---
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)

// --- サンプル：連続ローソク足検知 ---
bullish_count = 0
bearish_count = 0
for i = 0 to 9
    if close[i] > open[i]
        bullish_count := bullish_count + 1
    else if close[i] < open[i]
        bearish_count := bearish_count + 1

// --- サンプル：シグナル生成 ---
long_signal = ta.crossover(ma20, ma50)
short_signal = ta.crossunder(ma20, ma50)

// --- エクスポート用のプロット ---
plotchar(long_signal, "LONG", "▲", location.belowbar, color.green, size=size.small)
plotchar(short_signal, "SHORT", "▼", location.abovebar, color.red, size=size.small)

// --- CSV出力用のログ（TradingViewのコンソールにコピー） ---
// if barstate.isconfirmed
//     log.info(str.format("{0},{1},{2},{3},{4},{5},{6}",
//          time, open, high, low, close,
//          long_signal ? 1 : 0,
//          short_signal ? 1 : 0))

// ========================================
// 出力フォーマット（pine_signals.csv）:
// timestamp,open,high,low,close,long_signal,short_signal,ma20,ma50
// ========================================
